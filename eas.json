{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "autoIncrement": true,
      "env": {
        "ECLIPSE_BUILD_ENV": "staging",
        "EXPO_PUBLIC_ORGANIZER_CANCELLATION_BILLING": "true",
        "EXPO_PUBLIC_API_URL": "https://eclipse-staging-staging.up.railway.app"
      },
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "ECLIPSE_BUILD_ENV": "production"
      },
      "autoIncrement": true,
      "environment": "production",
      "channel": "production"
    },
    "testflight": {
      "extends": "preview",
      "distribution": "store",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6773071994"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6773071994"
      }
    }
  }
}

