{
  "cli": {
    "version": ">=25.3.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "testflight": {
      "distribution": "store",
      "environment": "preview",
      "ios": {
        "resourceClass": "m-medium",
        "credentialsSource": "remote"
      },
      "env": {
        "EAS_REUSE_ECLIPSE": "true",
        "EXPO_PUBLIC_API_URL": "https://api.weareeclipseoficial.com",
        "EXPO_PUBLIC_RELEASE_MODE": "beta"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "ios": {
        "resourceClass": "m-medium",
        "credentialsSource": "remote"
      },
      "env": {
        "EAS_REUSE_ECLIPSE": "true",
        "EXPO_PUBLIC_RELEASE_MODE": "production"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6773071994"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6773071994"
      }
    }
  }
}
