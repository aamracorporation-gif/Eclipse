# No credentials or identifiers from Eclipse. Default: local only.
PORT=4173
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4173
AUTH_MODE=local
PAYMENT_MODE=simulated
# Expo development only; exported web uses its own origin.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4173
# Optional, only after explicit approval of the exact Supabase destination.
# Keep real runtime credentials outside the delivery directory.
# ALLOW_REMOTE_DATABASE=approved-existing-project
# REMOTE_PROJECT_REF=exact_project_reference
# A dedicated rondiqo_backend login, scoped to the rondiqo schema, is required.
# DATABASE_URL=postgresql://...
# SUPABASE_URL=https://YOUR_APPROVED_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local defaults. See deploy/release.env.example for guarded beta/live configuration.
# RELEASE_MODE=local
# PAYMENT_MODE=stripe_test
# STRIPE_RESTRICTED_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PLATFORM_FEE_BPS=500
