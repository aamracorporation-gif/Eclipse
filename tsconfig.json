{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "react"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/**/*.tsx",
    "src/domain/**/*.ts",
    "src/ui/**/*.tsx",
    "src/ui/theme.ts",
    "src/api.ts",
    "server/**/*.ts",
    "tests/**/*.ts",
    "lib/AppStateContext.tsx",
    "lib/AuthContext.tsx",
    "lib/EventContext.tsx",
    "lib/NotificationContext.tsx",
    "lib/FilterContext.tsx",
    "components/rondiqo/**/*.tsx",
    "scripts/check-appfest.ts",
    "scripts/bootstrap-appfest-demo.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "supabase",
    "__tests__"
  ]
}