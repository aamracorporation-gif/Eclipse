Update the dependencies array to be: [permission?.granted, requestPermission]",{"range":"595","text":"596"},"Update the dependencies array to be: [myEventIds, myEventIdsKey, user?.id]",{"range":"597","text":"598"},"Update the dependencies array to be: [fetchData, user.id]",{"range":"599","text":"600"},"Update the dependencies array to be: [user?.id, verificationStatus, stripeStatus.stripe_account_id, stripeStatus.stripe_onboarding_completed, refreshStripe]",{"range":"601","text":"602"},"Update the dependencies array to be: [fetchWorkers, user]",{"range":"603","text":"604"},"Update the dependencies array to be: [fetchEvent, id, user]",{"range":"605","text":"606"},"Update the dependencies array to be: [filters, allListings, applyFilters]",{"range":"607","text":"608"},"Update the dependencies array to be: [getVipMatch, t]",{"range":"609","text":"610"},"Update the dependencies array to be: [fetchDashboardData]",{"range":"611","text":"612"},"Update the dependencies array to be: [fetchEventsAndSelectNearest, permission?.granted, requestPermission]",{"range":"613","text":"614"},"Update the dependencies array to be: [fetchAssignedEvents]",{"range":"615","text":"616"},[3233,3239],"[locationStatus, step]",[14720,14793],"[activeFilter, buildProfilesQuery, searchDebounced]",[4311,4317],"[router, user]",[10875,10895],"[isEditing, eventId, getEventById, localeTag]",[3731,3742],"[event.id, event.price]",[4944,7273],"useCallback(async () => {\n    if (!user) return;\n    try {\n      const { data, error } = await supabase\n        .from('profiles')\n        .select('verification_status, role, stripe_account_id, stripe_onboarding_completed, stripe_charges_enabled')\n        .eq('id', user.id)\n        .maybeSingle();\n      if (error) throw error;\n\n      setVerificationStatus((data?.verification_status as any) ?? null);\n      const role = (data?.role as any) ?? (user.user_metadata?.role as any) ?? null;\n      setProfileRole(role);\n      setStripeAccountId(data?.stripe_account_id || null);\n      \n      // Consideramos onboarding completado si ya lo estaba o si charges_enabled es true\n      const isComplete = !!data?.stripe_onboarding_completed || !!data?.stripe_charges_enabled;\n      setOnboardingCompleted(isComplete);\n\n      // AUTO-REFRESH STRIPE STATUS IF NOT COMPLETE\n      if (role === 'organizer' && data?.stripe_account_id && !isComplete) {\n        console.log('[DEBUG] Checking real Stripe status...');\n        try {\n          const { refreshStripeConnectStatus } = await import('@/lib/payments/api');\n          const status = await refreshStripeConnectStatus();\n          console.log('[DEBUG] Stripe real status:', status);\n          \n          // Consideramos OK si charges_enabled es true\n          if (status.stripe_charges_enabled || status.stripe_onboarding_completed) {\n            console.log('[DEBUG] Stripe status is now COMPLETED/ENABLED');\n            setOnboardingCompleted(true);\n            // Re-fetch everything after status change to ensure consistency\n            setTimeout(() => fetchMyProfile(), 500);\n          }\n        } catch (e) {\n          console.error('[DEBUG] Failed to auto-refresh Stripe status:', e);\n        }\n      }\n\n      // FETCH REAL STRIPE STATS - Only if onboarding is completed\n      if (role === 'organizer' && data?.stripe_account_id && (isComplete || !!data?.stripe_charges_enabled)) {\n        try {\n          console.log('[DEBUG] Fetching Stripe stats...');\n          const stats = await getStripeAccountStats();\n          console.log('[DEBUG] Stripe stats received:', stats);\n          setStripeStats(stats);\n        } catch (e) {\n          console.error('[DEBUG] Error fetching Stripe stats:', e);\n        }\n      }\n    } catch (e) {\n      console.error('Error in fetchMyProfile:', e);\n    }\n  })",[16224,16239],"[fetchMyProfile, fetchStats, isAdmin, refreshEvents]",[16374,16389],"[fetchMyProfile, fetchStats, isAdmin, user]",[16791,16793],"[fetchMyProfile]",[16925,16940],"[fetchAdminSummary, isAdmin, user]",[19803,19826],"[events, fetchStats, isAdmin, salesData, user]",[1735,1745],"[user.id, user.user_metadata]",[1386,1388],"[permission?.granted, requestPermission]",[2521,2546],"[myEventIds, myEventIdsKey, user?.id]",[5822,5832],"[fetchData, user.id]",[7967,8071],"[user?.id, verificationStatus, stripeStatus.stripe_account_id, stripeStatus.stripe_onboarding_completed, refreshStripe]",[1098,1104],"[fetchWorkers, user]",[3973,3983],"[fetchEvent, id, user]",[5176,5198],"[filters, allListings, applyFilters]",[10817,10819],"[getVipMatch, t]",[2077,2079],"[fetchDashboardData]",[1816,1818],"[fetchEventsAndSelectNearest, permission?.granted, requestPermission]",[1901,1903],"[fetchAssignedEvents]"]