{
  "expo": {
    "name": "RONDIQO",
    "slug": "rondiqo",
    "version": "0.4.0",
    "scheme": "rondiqo",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rondiqo.mobile"
    },
    "android": {
      "package": "app.rondiqo.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon.png",
        "backgroundColor": "#D9FA65"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "RONDIQO",
      "favicon": "./assets/brand/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite que RONDIQO lea los pases QR de tu competición.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "icon": "./assets/brand/icon.png"
  }
}
