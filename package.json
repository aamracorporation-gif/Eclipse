{
  "name": "eclipse",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node backend/src/index.js",
    "api": "node backend/src/index.js",
    "build": "cd backend && npm install --omit=dev",
    "dev": "cd backend && npm run dev",
    "start:expo": "npx expo start --lan",
    "start:clear": "npx expo start --lan --clear",
    "start:lan:8082": "npx expo start --lan --clear --port 8082",
    "start:localhost": "npx expo start --localhost --clear",
    "start:tunnel": "npx expo start --tunnel --clear",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "eas:build:android:preview": "eas build -p android --profile preview",
    "eas:configure": "eas build:configure",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/permanent-marker": "^0.4.0",
