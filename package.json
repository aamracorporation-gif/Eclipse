{
  "name": "rondiqo-eclipse",
  "main": "expo-router/entry",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "expo start --localhost",
    "web": "expo start --web --localhost",
    "build:web": "expo export --platform web",
    "api": "node --experimental-strip-types server/index.ts",
    "start": "node --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "seed": "node --experimental-strip-types scripts/seed.ts && node --experimental-strip-types scripts/seed-football.ts",
    "start:expo": "expo start --localhost",
    "start:connected": "powershell -NoProfile -File start-appfest.ps1",
    "postinstall": "node scripts/patch-build-tools.cjs",
    "eas-build-pre-install": "node scripts/verify-native-release.cjs",
    "security:runtime": "npm audit --omit=dev --prefix deploy/runtime"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "expo": "^58.0.16",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@napi-rs/canvas": "^1.0.0",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
